# EmailJS — powers the contact form. Create a free service at
# https://dashboard.emailjs.com, then copy these three values in.
# Without them the form tells visitors to email directly instead.
# These are publishable client-side keys, not secrets.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
